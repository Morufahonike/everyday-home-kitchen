# Copy to .env for local development. NEVER commit a real .env file.
# Every value below is a placeholder.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Path of the Django admin (change from the default in production)
DJANGO_ADMIN_URL=store-admin/
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/everyday_home_kitchen

# --- Security (production) ---
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# --- Store ---
STORE_CURRENCY=NGN
STORE_CURRENCY_SYMBOL=₦
STORE_TIME_ZONE=Africa/Lagos
LOW_STOCK_THRESHOLD=5

# --- Email (console backend prints emails to the log; no email service used) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Everyday Home Kitchen <no-reply@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- Payments ---
# "mock" = simulated payments for local work; "paystack" = Paystack (test keys first).
PAYMENT_PROVIDER=mock
# Keep false until the owner explicitly approves live payments.
PAYMENT_LIVE_MODE=false
ALLOW_MOCK_PAYMENTS=true
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-a-random-test-secret

# Paystack keys: copy from Paystack Dashboard > Settings > API Keys & Webhooks.
# Enter real values ONLY in your hosting environment settings (e.g. Railway Variables),
# never in this file, in chat, or in GitHub. Use sk_test_ / pk_test_ keys until live approval.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Payment channels offered on Paystack checkout (card covers Mastercard, Visa, Verve).
PAYSTACK_CHANNELS=card
PAYSTACK_TIMEOUT_SECONDS=15

# --- Supplier integration (DISABLED until a supplier is approved) ---
SUPPLIER_ADAPTER=none
SUPPLIER_SYNC_ENABLED=false
SUPPLIER_ORDER_SUBMISSION_ENABLED=false
SUPPLIER_API_BASE_URL=
SUPPLIER_API_KEY=

# --- Media uploads (product images). On Railway, point this at a mounted volume. ---
MEDIA_ROOT=
SERVE_MEDIA=false
